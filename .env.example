# PerkCart Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.

# Django Security Settings
SECRET_KEY=your-secure-django-secret-key-here-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to SQLite for local development)
# For production PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/perkcart_db
DATABASE_URL=

# AI Assistant API Credentials (Optional)
# If provided, enables Google Gemini generative response grounding.
# If omitted or empty, PerkCart automatically uses its verified Search-Based Fallback Engine.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
